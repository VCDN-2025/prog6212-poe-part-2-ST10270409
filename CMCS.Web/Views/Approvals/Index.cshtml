@model IEnumerable<CMCS.Web.Models.ApprovalVm>
@{
    ViewData["Title"] = "Approvals";
}
<h2 class="mb-3">Approvals</h2>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Lecturer</th>
            <th>Month</th>
            <th>Stage</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Lecturer</td>
                <td>@a.MonthLabel</td>
                <td>@a.Stage</td>
                <td><span class="badge bg-warning text-dark">@a.Status</span></td>
                <td class="text-end">
                    <div class="btn-group">
                        <button class="btn btn-sm btn-success" disabled>Approve</button>
                        <button class="btn btn-sm btn-danger" disabled>Reject</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">Actions disabled to respect Part 1 (non-functional).</p>
