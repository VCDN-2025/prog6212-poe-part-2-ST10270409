@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "CMCS")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">CMCS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Claims" && ViewContext.RouteData.Values["action"]?.ToString()=="Create" ? "active" : null)"
                               asp-controller="Claims" asp-action="Create">Lecturer: Create</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Claims" && ViewContext.RouteData.Values["action"]?.ToString()=="My" ? "active" : null)"
                               asp-controller="Claims" asp-action="My">Lecturer: My</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Coordinator" ? "active" : null)"
                               asp-controller="Coordinator" asp-action="Index">Coordinator</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Manager" ? "active" : null)"
                               asp-controller="Manager" asp-action="Index">Manager</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Reports" ? "active" : null)"
                               asp-controller="Reports" asp-action="Index">HR / Reports</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-light small">PROG6212 • Part 2</span>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top py-3">
        <div class="container small text-muted">
            © @DateTime.Now.Year CMCS — Contract Monthly Claim System
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
